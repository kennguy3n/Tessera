{
  "tables": [
    {
      "id": "tbl-incidents",
      "name": "Incidents",
      "fields": [
        { "name": "Incident ID", "type": "text" },
        { "name": "Date Discovered", "type": "date" },
        {
          "name": "Type",
          "type": "select",
          "options": ["Lost Device", "Unauthorized Access", "Misdirected Email"]
        },
        {
          "name": "Severity",
          "type": "select",
          "options": ["High", "Medium", "Low"]
        },
        { "name": "Individuals Affected", "type": "number" },
        { "name": "Encrypted", "type": "checkbox" },
        {
          "name": "Status",
          "type": "select",
          "options": [
            "Risk Assessment",
            "Open",
            "Closed-Incident",
            "Reportable"
          ]
        },
        {
          "name": "Owner",
          "type": "linked_record",
          "linkedTableId": "tbl-owners",
          "linkedDisplayField": "Name"
        },
        {
          "name": "Owner Role",
          "type": "lookup",
          "linkedField": "Owner",
          "targetField": "Role"
        },
        {
          "name": "Reportable",
          "type": "formula",
          "formula": "IF({Individuals Affected} >= 500, \"Reportable\", \"Assess\")"
        },
        { "name": "Risk Score", "type": "rating" }
      ],
