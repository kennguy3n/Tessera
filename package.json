{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first open-source productivity workspace",
  "license": "MIT",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspace=apps/desktop",
    "build:kchat-extension": "cd extensions/tessera-kchat && ../../node_modules/.bin/tsc -p tsconfig.json && node ./scripts/build.mjs",
    "test:kchat-extension": "cd extensions/tessera-kchat && node --enable-source-maps --test ./scripts/build.test.mjs",
    "build:native": "echo 'napi build placeholder — requires full napi-rs toolchain'",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "npm run test --workspace=apps/desktop",
    "test:rust": "cargo test --all",
    "test:smoke": "npm run test:smoke --workspace=apps/desktop && npm run test:smoke:rust",
    "test:smoke:rust": "cargo test -p tessera_templates --test smoke_templates && cargo test -p tessera_connectors --test smoke_connectors && cargo test -p tessera_export --test smoke_export",
    "test:smoke:linux": "bash scripts/smoke-test-linux.sh",
    "verify:package:windows": "pwsh -File scripts/verify-windows-package.ps1",
    "verify:package:macos": "bash scripts/verify-macos-package.sh",
    "lint": "npm run lint --workspace=apps/desktop",
    "type-check": "npm run type-check --workspace=apps/desktop",
    "format": "prettier --write '**/*.{ts,tsx,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,css,md}'"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
