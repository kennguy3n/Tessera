# QA build mode (`vite build --mode qa`, run via `npm run build:qa`).
#
# Enables the showcase mock bridge inside a *production* bundle so the
# deterministic QA gates (visual-regression + the browser a11y contrast
# pass + the interaction perf harness) can drive real surfaces with
# seeded data. This flag is read in `renderer/src/main.tsx`; it is never
# set for the real `npm run build`, so the showcase code path is
# tree-shaken out of the shipped renderer.
VITE_TESSERA_QA=true
