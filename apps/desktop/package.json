{
  "name": "@tessera/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tessera desktop application — Electron + React",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.electron.json",
    "build:native": "cargo build --release -p tessera_bridge",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run renderer/src/__tests__/smoke/featureVerification.test.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@marp-team/marp-cli": "^4.4.0",
    "@marp-team/marp-core": "^4.3.0",
    "@marp-team/marpit": "^3.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "tar": "^7.5.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
