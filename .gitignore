# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed (Tessera is an application/binary, not a library)
# so CI gets reproducible builds and is shielded from surprise transitive
# dependency upgrades requiring newer Rust editions.

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Build output
dist/
out/
build/
*.node

# Electron
apps/desktop/dist/
apps/desktop/renderer-dist/
apps/desktop/renderer-dist-qa/
apps/desktop/dist-electron/
apps/desktop/out/
apps/desktop/release/

# Playwright (QA a11y / visual-regression harness) run artifacts.
# Baseline snapshots live under qa/visual.spec.ts-snapshots/ and ARE
# committed; only the transient run output (diffs, traces, last-run
# metadata) is ignored.
apps/desktop/test-results/
apps/desktop/playwright-report/
apps/desktop/blob-report/
apps/desktop/.playwright/

# Emitted by `tsc -p tsconfig.node.json` (composite build of vite.config.ts)
# during `npm run build` — transient, never committed.
apps/desktop/vite.config.js
apps/desktop/vite.config.d.ts
apps/desktop/*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Test
coverage/
*.lcov

# Python (showcase generator bytecode)
__pycache__/
*.pyc

# OS
.DS_Store
Desktop.ini
ehthumbs.db
