# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed (Tessera is an application/binary, not a library)
# so CI gets reproducible builds and is shielded from surprise transitive
# dependency upgrades requiring newer Rust editions.

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Build output
dist/
out/
build/
*.node

# Electron
apps/desktop/dist/
apps/desktop/renderer-dist/
apps/desktop/dist-electron/
apps/desktop/out/
apps/desktop/release/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Test
coverage/
*.lcov

# Python (showcase generator bytecode)
__pycache__/
*.pyc

# OS
.DS_Store
Desktop.ini
ehthumbs.db
